import "@typespec/http";
import "@typespec/openapi";
import "./models/common.tsp";
import "./models/owner.tsp";
import "./models/event-type.tsp";
import "./models/slot.tsp";
import "./models/booking.tsp";
import "./routes/public.tsp";
import "./routes/admin.tsp";

using Http;
using OpenAPI;

@service(#{ title: "Simple Cal.com API" })
@info(#{ version: "1.0.0" })
@server("http://localhost:3000", "Локальная разработка")
@tagMetadata(#[
  #{
    name: "Guest",
    description: """
      Публичная часть для гостя. Аутентификации нет: записаться может любой, у кого есть ссылка.
      
      Сценарий гостя:
      1. `GET /owner` — узнать, к кому идёт запись.
      2. `GET /event-types` — посмотреть виды брони: название, описание, длительность.
      3. `GET /event-types/{eventTypeId}/slots` — открыть календарь свободных слотов на ближайшие 14 дней.
      4. `POST /bookings` — занять выбранный слот, указав имя и email.
      
      Гость не видит чужие бронирования и не может получить их список.
      """,
  },
  #{
    name: "Owner",
    description: """
      Админская часть для владельца календаря. Аутентификации нет: роль выражена только
      префиксом пути `/admin`, чтобы позже можно было навесить авторизацию, не меняя структуру API.
      
      Сценарий владельца:
      1. `POST /admin/event-types` — завести тип события: название, описание, длительность.
      2. `GET /admin/event-types`, `PATCH`, `DELETE` — поддерживать список видов брони в актуальном состоянии.
      3. `GET /admin/bookings` — смотреть предстоящие встречи одним списком по всем типам событий.
      """,
  }
])
@doc("""
  API упрощённого сервиса записи на встречи.
  
  ## Роли
  
  Регистрации и авторизации в системе нет. Роли различаются только префиксом пути:
  
  - **Владелец календаря** — единственный преднастроенный профиль (`Owner`). Работает с `/admin/*`:
    ведёт типы событий и просматривает предстоящие встречи.
  - **Гость** — анонимный посетитель без аккаунта. Работает с публичными путями:
    смотрит виды брони, выбирает свободный слот и создаёт бронирование.
  
  ## Доменные сущности
  
  - `Owner` — владелец календаря. Один на всю систему, ему принадлежат все типы событий и бронирования.
  - `EventType` — тип события: шаблон встречи с названием, описанием и длительностью в минутах.
  - `Slot` — вычисляемый свободный интервал. Не хранится, рассчитывается по запросу.
  - `Booking` — бронирование: занятый гостем интервал в календаре владельца.
  
  ## Правила
  
  - **Сетка времени.** Слоты начинаются на границе 30 минут. Длительность типа события кратна 30
    и занимает соответствующее число ячеек подряд.
  - **Занятость.** На пересекающееся время нельзя создать два бронирования, даже если это разные
    типы событий. Проверяется пересечение интервалов, а не совпадение начала.
  - **Окно записи.** Свободные слоты формируются на 14 дней, начиная с текущей даты. Записаться
    можно только на свободный слот из этого окна.
  - **Время.** Все моменты времени передаются в UTC (`utcDateTime`), календарные дни — как `plainDate`
    в UTC. Часовой пояс не хранится, перевод в локальное время — задача клиента.
  """)
namespace SimpleCalCom;
