import "./common.tsp";

namespace SimpleCalCom;

@doc("""
  Владелец календаря — единственный преднастроенный профиль в системе.
  Регистрации и входа нет: профиль существует изначально и не создаётся через API.
  Владельцу принадлежат все типы событий и все бронирования, поэтому занятость времени
  считается по всему календарю целиком, а не по отдельным типам событий.
  """)
model Owner {
  @doc("Стабильный идентификатор профиля владельца.")
  id: Uuid;

  @doc("Отображаемое имя, которое гость видит на публичной странице записи.")
  @minLength(1)
  @maxLength(100)
  name: string;

  @doc("Короткое описание владельца, показывается рядом с именем.")
  @maxLength(500)
  bio?: string;
}
