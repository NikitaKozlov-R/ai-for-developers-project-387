import "./common.tsp";

namespace SimpleCalCom;

@doc("""
  Слот — вычисляемый интервал времени, на который гость может записаться.
  Слоты не хранятся: сервер строит их на лету из рабочих часов владельца,
  сетки в 30 минут и длительности выбранного типа события.
  Слот попадает в ответ, только если он полностью свободен, то есть не пересекается
  ни с одним существующим бронированием любого типа события.
  """)
model Slot {
  @doc("Начало слота.")
  startsAt: utcDateTime;

  @doc("Конец слота: `startsAt` плюс длительность выбранного типа события.")
  endsAt: utcDateTime;
}

@doc("Свободные слоты одного календарного дня. День без свободных слотов возвращается с пустым списком.")
model DaySlots {
  @doc("Календарный день в UTC.")
  date: plainDate;

  slots: Slot[];
}

@doc("Календарь свободных слотов для одного типа события внутри окна записи.")
model SlotsResponse {
  @doc("Тип события, для которого рассчитаны слоты.")
  eventTypeId: Uuid;

  @doc("Длительность типа события в минутах: определяет длину каждого слота.")
  durationMinutes: int32;

  @doc("Первый день рассчитанного диапазона включительно.")
  rangeStart: plainDate;

  @doc("Последний день рассчитанного диапазона включительно.")
  rangeEnd: plainDate;

  @doc("Дни диапазона по возрастанию, слоты внутри дня — тоже по возрастанию.")
  days: DaySlots[];
}
