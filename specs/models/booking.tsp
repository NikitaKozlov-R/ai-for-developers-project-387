import "./common.tsp";
import "./event-type.tsp";

namespace SimpleCalCom;

@doc("Гость, записавшийся на встречу. Аккаунт не создаётся, эти данные живут только внутри бронирования.")
model Guest {
  @doc("Имя гостя.")
  @minLength(1)
  @maxLength(100)
  name: string;

  @doc("Email гостя для связи.")
  email: Email;
}

@doc("""
  Бронирование — занятый интервал в календаре владельца.
  Ключевой инвариант: два бронирования не могут пересекаться по времени, даже если
  относятся к разным типам событий. Проверяется именно пересечение интервалов,
  а не совпадение начала: встреча на 60 минут в 10:00 блокирует и 10:30.
  """)
model Booking {
  @doc("Идентификатор бронирования, назначается сервером.")
  id: Uuid;

  @doc("Тип события, по которому создано бронирование.")
  eventType: EventTypeSummary;

  @doc("Начало встречи.")
  startsAt: utcDateTime;

  @doc("Конец встречи: вычисляется сервером как `startsAt` плюс длительность типа события.")
  endsAt: utcDateTime;

  guest: Guest;

  @doc("Момент создания бронирования.")
  createdAt: utcDateTime;
}

@doc("""
  Тело запроса на создание бронирования. `endsAt` не передаётся: сервер вычисляет его
  из длительности типа события, чтобы клиент не мог рассинхронизировать длительность.
  """)
model BookingCreate {
  @doc("Идентификатор выбранного типа события.")
  eventTypeId: Uuid;

  @doc("""
    Начало встречи. Должно совпадать с началом одного из свободных слотов,
    возвращённых для этого типа события.
    """)
  startsAt: utcDateTime;

  guest: Guest;
}
